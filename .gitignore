# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Valve's Steamworks SDK and redistributables stay local; never commit them.
# steam_appid.txt is ours (written by SteamVirtualLAN) and is not ignored.
/steamworks/
sdk/
steamworks_sdk*/
steamworks_sdk*.zip
steam_api*.lib
libsteam_api.so
libsteam_api.dylib

# Wintun (wintun.dll from wintun.net) stays local too.
/wintun/
wintun*.zip

# No third-party binaries in the repository, wherever they end up.
*.dll

# Editors and OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
